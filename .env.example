# Copy to .env and fill in. Compose overrides the URLs for container use.
# Every value below is a default except where marked "required"; the app reads
# these through src/edu_rag/config.py, so the names must match exactly.

APP_ENV=local

# --- secrets ----------------------------------------------------------- #
# Required for generation. Grab one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- generation -------------------------------------------------------- #
# OpenRouter model id, e.g. google/gemini-2.5-pro or anthropic/claude-sonnet-4.5
GENERATION_MODEL=
# Requests per minute per process. The limiter starts full, so this is also
# the burst size.
LLM_REQUESTS_PER_MINUTE=30.0

# --- api --------------------------------------------------------------- #
# Largest upload accepted, in bytes (default 100 MiB).
MAX_UPLOAD_BYTES=104857600
# A generation left in `generating` for longer than this is treated as dead.
GENERATION_STALE_AFTER_SECONDS=900

# --- local (host) dev only; compose replaces these with service names --- #
# Required. The driver is psycopg v3, so keep the "+psycopg" suffix.
DATABASE_URL=postgresql+psycopg://edu:edu@localhost:5432/edu
CELERY_BROKER_URL=amqp://edu:edu@localhost:5672//
EMBEDDER_URL=http://localhost:8081
RERANKER_URL=http://localhost:8082

# --- embeddings -------------------------------------------------------- #
# Model id used to load a matching tokenizer locally for token-sized batches.
# Must match the model the TEI embedder container is serving.
EMBEDDER_MODEL=microsoft/harrier-oss-v1-0.6b
# Must match EMBEDDER_MODEL's width; it is also the pgvector column width.
EMBEDDING_DIM=1024
MAX_INPUT_TOKENS=32768
# Applied to queries only, so it can change without re-embedding documents.
# Topic and HyDE variants live in src/edu_rag/config.py.
QUERY_INSTRUCTION=Given a question, retrieve passages that answer it

# --- retrieval --------------------------------------------------------- #
CHUNK_SIZE=512
RETRIEVE_QUERIES=6
RETRIEVE_CANDIDATES=50
# Expand to whole 4- or 16-chunk groups before reranking.
RETRIEVE_AUTO_MERGE=true
RRF_K=30
CONTEXT_CHUNKS=15

# --- network ----------------------------------------------------------- #
# Seconds before a call to TEI or OpenRouter is abandoned.
HTTP_TIMEOUT=30.0
