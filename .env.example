# Copy to .env and fill in. Compose overrides the URLs for container use.

APP_ENV=local

# --- secrets ----------------------------------------------------------- #
OPENROUTER_API_KEY=

# --- local (host) dev only; compose replaces these with service names --- #
DATABASE_URL=postgresql+psycopg://edu:edu@localhost:5432/edu
CELERY_BROKER_URL=amqp://edu:edu@localhost:5672//
EMBEDDER_URL=http://localhost:8081
RERANKER_URL=http://localhost:8082
